{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "guildcore-discord",
  "main": "worker.js",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}