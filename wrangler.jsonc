{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "guildcore-v6",
  "main": "worker.js",
  "compatibility_date": "2026-09-18",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guildcore-v6",
      "database_id": "63ac1865-8993-40db-96ec-dd8c8641245d"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}